# ─────────────────────────────────────────────────────────────
# Hungru Pizza Barasat — environment configuration
# Copy to .env.local (development) or set in your hosting dashboard.
# Never commit real values.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (required).
# Local:  postgres://hungru:hungru_dev@localhost:5432/hungru
# Hosted: Neon / Supabase / Railway / RDS connection string (use sslmode=require)
DATABASE_URL=postgres://hungru:hungru_dev@localhost:5432/hungru

# Public URL of the website, used for canonical links, sitemap and social cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where uploaded media is stored:
#   db  — inside PostgreSQL (default, works everywhere incl. serverless)
#   fs  — on local disk at MEDIA_DIR (single VPS / persistent disk only)
MEDIA_STORAGE=db
MEDIA_DIR=./storage/media

# First admin account — used ONLY by `npm run admin:create`.
# Pick a strong password (min 10 chars). Remove these after creating the account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Owner
